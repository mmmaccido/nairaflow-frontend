# ─── NairaFlow Frontend — Production Environment Variables ───────────────────
#
# Copy this file to .env.production (or set these vars in your hosting platform).
# All NEXT_PUBLIC_* vars are inlined at build time — never put secrets here.
#
# For local development, copy to .env.local and set NEXT_PUBLIC_API_URL to
# http://localhost:8000/api

# Base URL of the NairaFlow Laravel API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api.nairaflow.com/api

# Paystack public key (used client-side to initialise the Paystack popup)
# Get this from https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your-paystack-public-key
